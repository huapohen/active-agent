ll},"content":[{"text":"Doc Free 保持不变","type":"text"}]}]},{"type":"tableCell","attrs":{"align":null,"colspan":1,"rowspan":1,"colwidth":null,"backgroundColor":null,"backgroundColorName":null},"content":[{"type":"paragraph","attrs":{"id":"dhvmkftecqmk","indent":0,"textAlign":null},"content":[{"text":"dc728ddc99ce3bc7346bb4dc364824bbb32b1101","type":"text","marks":[{"type":"code"}]}]}]},{"type":"tableCell","attrs":{"align":null,"colspan":1,"rowspan":1,"colwidth":null,"backgroundColor":null,"backgroundColorName":null},"content":[{"type":"paragraph","attrs":{"id":"crqdqwqaulal","indent":0,"textAlign":null},"content":[{"text":"2026-09-09T01:22:28+08:00","type":"text","marks":[{"type":"code"}]}]}]},{"type":"tableCell","attrs":{"align":null,"colspan":1,"rowspan":1,"colwidth":null,"backgroundColor":null,"backgroundColorName":null},"content":[{"type":"paragraph","attrs":{"id":"ntssditcuuwa","indent":0,"textAlign":null},"content":[{"text":"本阶段不修改 Doc Free 源码，继续通过现有文档与投影网关归档","type":"text"}]}]}]}]},{"type":"paragraph","attrs":{"id":"smuzlsqnxbww","indent":0,"textAlign":null},"content":[{"text":"主要实现包含 43 个文件、3,652 行新增和 101 行删除。原生验收修复另有 13 个文件、140 行新增和 11 行删除，归属独立修复提交。","type":"text"}]},{"type":"heading","attrs":{"id":"rfzwpyocjvlz","level":2,"indent":0,"textAlign":null},"content":[{"text":"本阶段交付的行为","type":"text"}]},{"type":"heading","attrs":{"id":"blxgueystiho","level":3,"indent":0,"textAlign":null},"content":[{"text":"1. 人与 Agent 可通过同一邀请核心加入工作空间","type":"text"}]},{"type":"paragraph","attrs":{"id":"eqsuuuruakfa","indent":0,"textAlign":null},"content":[{"text":"电脑端的头像、加号和空工作空间页面提供邀请或加入入口。所有者/管理员可创建仅授予普通成员身份的一次性邀请，选择 1 小时、24 小时或 7 天有效期，查看实际邀请记录并明确撤销。加入时使用当前已验证的身份；客户端不能通过填写姓名、邮箱、角色或 principal ID 冒充另一位同事。","type":"text"}]},{"type":"paragraph","attrs":{"id":"gdiuwsmlajbq","indent":0,"textAlign":null},"content":[{"text":"服务端生成 256 位随机邀请码，只存 SHA-256。明文只在首次创建响应返回，动作重放、动作查询、邀请列表、事件表及执行审计均不返回它。客户端仅在当前实例内存保存明文；本地持久化原 action ID、目标与用于匹配原邀请码的 SHA-256，不把明文放进 URL、查询缓存或 sessionStorage。复制问题见下方原生验收记录。","type":"text"}]},{"type":"paragraph","attrs":{"id":"ipqdzxhemdtv","indent":0,"textAlign":null},"content":[{"text":"结果未知时核对原 action，不自动生成第二份邀请。接受请求发生超时、换身份或刷新后，原意图仍被保护；重新输入不同邀请码不能替代原来的未决意图。明确收到过期、撤销或已使用的错误后，才允许开始新接受意图。服务器 action 查询不表示可以从历史回执恢复明文；丢失明文的邀请需明确撤销后另建。","type":"text"}]},{"type":"paragraph","attrs":{"id":"wytdoexnkirl","indent":0,"textAlign":null},"content":[{"text":"Agent 使用真实机器认证与明确 Run，创建、列表、撤销、接受、原动作查询均经过权限核验。Agent 接受跨工作空间邀请仅增加 member 成员关系，不改变 executor 注册工作空间、原 Run 或任何继承来源。Agent 发出的未消费邀请在另一身份接受时再次核验发行者角色、机器绑定、策略版本、来源群的权限/停止状态/epoch；已完成的发行 Run 可以保持邀请有效，但停止、撤权、旧 epoch 或失效绑定不能继续发放新权限。","type":"text"}]},{"type":"paragraph","attrs":{"id":"mfikuthxszng","indent":0,"textAlign":null},"content":[{"text":"邀请码不会自动加群，不会授予管理员，不会开通融云 SDK，也不会发邮件或真实飞书消息。管理台、公司域验证、大规模邀请和完整成员生命周期仍不在本阶段完成声明中。","type":"text"}]},{"type":"heading","attrs":{"id":"nzrerszyqugk","level":3,"indent":0,"textAlign":null},"content":[{"text":"2. Agent 原生读取融云到达事件","type":"text"}]},{"type":"paragraph","attrs":{"id":"mlzvccjxktva","indent":0,"textAlign":null},"content":[{"text":"GET /v1/transport/events","type":"text","marks":[{"type":"code"}]},{"text":" 和 MCP ","type":"text"},{"text":"transport_arrival_read","type":"text","marks":[{"type":"code"}]},{"text":" 使用相同读取核心。机器必须提交当前 Run；服务器确定接收身份、固定 executor 与当前桥覆盖，模型不能指定或借用别人的 receiver。每页在同一个事务内检查全部来源、成员关系、停止状态、epoch、策略与 Run 终态；游标必须属于该接收身份和当前 Run 覆盖。","type":"text"}]},{"type":"paragraph","attrs":{"id":"jzlvjyxmdrro","indent":0,"textAlign":null},"content":[{"text":"Eino 增加 ","type":"text"},{"text":"im_transport_arrival_read","type":"text","marks":[{"type":"code"}]},{"text":"，模型只给 ","type":"text"},{"text":"after","type":"text","marks":[{"type":"code"}]},{"text":" 和 ","type":"text"},{"text":"limit","type":"text","marks":[{"type":"code"}]},{"text":"，Run 来自执行上下文。可替换工具的返回也经过来源、预算和分页校验，读取前后再次检查授权，迟到的已撤权结果不进入后续模型和工具结果归档。","type":"text"}]},{"type":"paragraph","attrs":{"id":"cerffnkfrznb","indent":0,"textAlign":null},"content":[{"text":"unavailable","type":"text","marks":[{"type":"code"}]},{"text":"、已连接心跳和实际收到消息是不同事实。本机 Human 受控桥仍存活，未自动扩展给新账号或 Agent。本轮真实机器使用新短期 Clerk 凭证，在原工作空间原根群 epoch3 建立验收 Run；HTTP/MCP 返回逐字段相等，receiver 是该 Agent，未配置覆盖时返回空事件和 unavailable。验证后通过正常生命周期接口终结为 stopped，停止后执行读取 409、审计 200，原群状态未改。Agent 实际接受 Human 邀请未执行；不将隔离测试或 Human 创建邀请说成这条链路的现场成功。详见 ","type":"text"},{"text":"机器读取专题","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://github.com/huapohen/active-agent/blob/a58f429f9276a3fc4862fb71d6fba78d90b2a61c/docs/startup/2026-09-09/AGENT_RUN_ARRIVAL_NATIVE_READ_1042.md","class":null,"title":null,"target":"_blank","internal":false}}]},{"text":"。","type":"text"}]},{"type":"heading","attrs":{"id":"yorfrggzscfz","level":3,"indent":0,"textAlign":null},"content":[{"text":"3. 会话列表显示实际最后一条消息及时间","type":"text"}]},{"type":"paragraph","attrs":{"id":"sdewwfddkvew","indent":0,"textAlign":null},"content":[{"text":"正式 Go 消息表按会话批量查询最后序号、作者、最多 240 个 Unicode 字符的摘要和实际时间，不逐行额外发消息请求。HTTP/MCP 使用同一列表结果；Run 列表保持全部来源限制，普通账户列表与撤权操作按事务锁序一致。","type":"text"}]},{"type":"paragraph","attrs":{"id":"dqszkwstscmk","indent":0,"textAlign":null},"content":[{"text":"last_message: null","type":"text","marks":[{"type":"code"}]},{"text":" 表示经过查询确认没有消息；缺字段表示该响应未提供摘要。创建/停止等元数据回执不会伪造空摘要覆盖已有消息。客户端将二者分别显示“暂无消息”和“消息摘要暂未提供”。原有会话排序与 ID 游标没有改为未实现的活动时间排序。","type":"text"}]},{"type":"heading","attrs":{"id":"zkqxfdpmrqqy","level":2,"indent":0,"textAlign":null},"content":[{"text":"本机运行与原生验收","type":"text"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"fbebjakixjyz","indent":0,"textAlign":null},"content":[{"text":"用户已亲自完成 Clerk 真人验证和邮箱验证码。电脑端刷新后自动恢复已验证账号，保留原昵称、工作空间、群聊、中文消息、引用回复与表情回应；没有重新注册或重置密码。","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"hedzzhnxlghq","indent":0,"textAlign":null},"content":[{"text":"10:36:22 实际运行新版 Go API，3318 健康返回 ","type":"text"},{"text":"transport=rongcloud","type":"text","marks":[{"type":"code"}]},{"text":"，数据库 schema 10，旧受控接收桥仍存活。新进程仅启动 API，不启动模型 Worker 或历史 Outbox 派发。","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"eauczndjdqwh","indent":0,"textAlign":null},"content":[{"text":"升级前已做 PostgreSQL public schema 自定义格式备份，并用 ","type":"text"},{"text":"pg_restore --list","type":"text","marks":[{"type":"code"}]},{"text":" 核验。备份仅在 Git 忽略的私有目录中；完整连接串和凭据不进入报告。","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"gkruntnfnbfl","indent":0,"textAlign":null},"content":[{"text":"API 从实施提交的干净 detached worktree 构建。该本机 Go 产物没有嵌入 VCS metadata，因此构建回执记录实际源提交、干净工作区和产物 SHA-256，不声称二进制包含 commit 字段。","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"wsdmfxnkqbre","indent":0,"textAlign":null},"content":[{"text":"电脑端刷新会话后，已显示 09:15 和真实的最后回复摘要。","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"dssduujojmox","indent":0,"textAlign":null},"content":[{"text":"10:38 原生点击创建一次性邀请成功，记录为“待使用”；复制按钮真实返回失败，随后通过 UI 撤销并读到“已撤销”。该邀请未分享或消费。发现的 Electron 剪贴板限制、重复弹窗标题和底部可达性问题已在独立修复提交中解决，保留首次失败证据。","type":"text"}]}]}]},{"type":"paragraph","attrs":{"id":"vxbkomhfkxkk","indent":0,"textAlign":null},"content":[{"text":"末轮原生复验：","type":"text"}]},{"type":"orderedList","attrs":{"type":null,"start":1},"content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"yxljxddgwhsh","indent":0,"textAlign":null},"content":[{"text":"Electron 只增加一个受限文本写剪贴板接口，校验当前窗口、main frame、可信 origin 和文本边界；不增加读取剪贴板能力，不放宽整体权限策略。实际点击显示“已复制”。","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"gsrezpuaxojr","indent":0,"textAlign":null},"content":[{"text":"在同一应用打开加入表单，将剪贴板直接粘贴进密码式邀请码输入框；提交后显示“已加入 人机共创工作空间，成员列表已更新”。没有读取、打印或截取明文。","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"id":"czuxzuzhtwdj","indent":0,"textAlign":null},"content":[{"text":"此次由已经是 owner 的本人接受，服务回执 ","type":"text"},{"text":"already_member=true","type":"text","marks":[{"typ