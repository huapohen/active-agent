RENJI_LISTEN=127.0.0.1:3318
# Supply the password only in the private deployment configuration.
RENJI_DATABASE_URL=postgres://renji@127.0.0.1:55434/renji_startup?sslmode=disable
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
RENJI_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
RONGCLOUD_API_URL=https://api.rong-api.com
RONGCLOUD_APP_KEY=replace-me
RONGCLOUD_APP_SECRET=replace-me

# Machine authentication uses the receiving Clerk machine's dedicated secret.
CLERK_RECEIVER_MACHINE_ID=
CLERK_MACHINE_SECRET_KEY=
CLERK_ALLOW_NONEXPIRING_MACHINE_TOKENS=false
# Temporary isolated-test IDs only. Empty = no general SDK token issuance.
# RongCloud remains mandatory; server outbox delivery is independent of this gate.
RENJI_RONGCLOUD_TEST_PRINCIPALS=

# Agent worker: disabled until a real machine/executor binding is configured.
RENJI_HARNESS_ENABLED=false
RENJI_GATEWAY_URL=http://127.0.0.1:3318
RENJI_EXECUTOR_TOKEN=
RENJI_AGENT_PRINCIPAL_ID=
RENJI_EXECUTOR_ID=
RENJI_TEMPORAL_ADDRESS=127.0.0.1:7233
RENJI_TEMPORAL_NAMESPACE=renji-startup
RENJI_TEMPORAL_TASK_QUEUE=renji-agent-v1
RENJI_TEMPORAL_TLS=false
# Explicit protocol; responses never silently falls back to chat_completions.
RENJI_MODEL_API_STYLE=responses
RENJI_MODEL_BASE_URL=
RENJI_MODEL_API_KEY=
RENJI_MODEL_NAME=gpt-6-astra
RENJI_MODEL_REASONING_EFFORT=medium

# Fixed private server-side archive config; never provided by a Workflow/model.
# With no config, the archive outcome explicitly reports disabled.
RENJI_RUN_ARCHIVE_CONFIG=
