RENJI_LISTEN=127.0.0.1:3318
RENJI_DATABASE_URL=postgres://renji:replace-me@127.0.0.1:55434/renji_startup?sslmode=disable
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
RENJI_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
RONGCLOUD_API_URL=https://api.rong-api.com
RONGCLOUD_APP_KEY=replace-me
RONGCLOUD_APP_SECRET=replace-me

# Machine authentication uses the receiving Clerk machine's dedicated secret.
CLERK_RECEIVER_MACHINE_ID=
CLERK_MACHINE_SECRET_KEY=
CLERK_ALLOW_NONEXPIRING_MACHINE_TOKENS=false
# Temporary isolated-test IDs only. Empty = no general SDK token issuance.
# RongCloud remains mandatory; server outbox delivery is independent of this gate.
RENJI_RONGCLOUD_TEST_PRINCIPALS=
