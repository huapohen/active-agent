# Local development only. Keep .env out of Git and container images.
AA_DB_PATH=./data/active_agent.db
AA_DOC_FREE_URL=http://127.0.0.1:3217
AA_DOC_FREE_TOKEN=
AA_DOCUMENT_POLL_SECONDS=2

# Select an endpoint/model pair supported by your provider.
# Responses-only gateways require responses; use chat for Chat Completions.
AA_MODEL_API_KEY=
AA_MODEL_BASE_URL=https://api.openai.com/v1
AA_MODEL_NAME=gpt-6-astra
AA_MODEL_API_STYLE=responses
AA_MODEL_REASONING_EFFORT=medium
AA_MODEL_TIMEOUT=90

# Legacy 0.1 API settings (not required by the document workspace).
AA_NAME=AA
AA_MENTION=@AA
AA_API_TOKEN=
AA_TICK_SECONDS=30
AA_MIN_SILENCE_SECONDS=300
